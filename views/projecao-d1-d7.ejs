<%- include('partials/head') %>

<%
  // Mesma lista/rótulo de tipos do modal de upload de cotas em cotas-planejadas.ejs
  // (o <dialog> abaixo é a mesma peça, replicada aqui desde 2026-07-27 pra dar pra
  // reenviar a base sem sair da Projeção).
  const tiposCotas = [
    { tipo: 'reparo', label: 'Reparos' },
    { tipo: 'instalacao', label: 'Instalação' },
    { tipo: 'me', label: 'ME' },
    { tipo: 'servico', label: 'Serviço' },
  ];
  const rotuloTipo = (t) => (tiposCotas.find(x => x.tipo === t) || {}).label || t;
%>

<%
  // Uma entrada por seção; a tabela em si é o partial `tabela-projecao`. `dias`
  // (D1..D7, com a data de calendário real de cada um) é o mesmo pras 4 seções,
  // vem pronto da rota.
  const secoes = [
    {
      id: 'instalacao',
      label: 'Instalação',
      titulo: 'Projeção D1-D7 de Instalação',
      rotuloColuna: 'Instalação',
      linhas: linhasInstalacoes,
      aliadaCores: aliadaCoresInstalacoes,
      mapaCotas: mapaCotasInstalacao,
      mapaDetalhe: mapaDetalheInstalacao,
      opcoesJanela: opcoesJanelaInstalacao,
      campoTempo: 'tempoInstalacaoMinutos',
    },
    {
      id: 'servico',
      label: 'Serviços',
      titulo: 'Projeção D1-D7 de Serviços',
      rotuloColuna: 'Serviço',
      linhas: linhasServicos,
      aliadaCores: aliadaCoresServicos,
      mapaCotas: mapaCotasServico,
      mapaDetalhe: mapaDetalheServico,
      opcoesJanela: opcoesJanelaServico,
      campoTempo: 'tempoServicoMinutos',
    },
    {
      id: 'me',
      label: 'ME',
      titulo: 'Projeção D1-D7 de ME',
      rotuloColuna: 'ME',
      linhas: linhasMe,
      aliadaCores: aliadaCoresMe,
      mapaCotas: mapaCotasMe,
      mapaDetalhe: mapaDetalheMe,
      opcoesJanela: opcoesJanelaMe,
      campoTempo: 'tempoMeMinutos',
    },
    {
      id: 'reparo',
      label: 'Reparos',
      titulo: 'Projeção D1-D7 de Reparos',
      rotuloColuna: 'Reparo',
      linhas: linhasReparos,
      aliadaCores: aliadaCoresReparos,
      mapaCotas: mapaCotasReparo,
      mapaDetalhe: mapaDetalheReparo,
      opcoesJanela: opcoesJanelaReparo,
      campoTempo: 'tempoReparoMinutos',
    },
  ];
%>

<section class="panel" id="cotas-tabela">
  <div class="panel-header panel-header-row">
    <div>
      <% secoes.forEach((secao, i) => { %>
        <div class="secao-cabecalho" data-secao="<%= secao.id %>" <%= i === 0 ? '' : 'hidden' %>>
          <h2 class="tabela-card-titulo"><%= secao.titulo %></h2>
          <p class="tabela-card-contexto">
            Cluster GOIANIA · <%= secao.linhas.length %> buckets · 7 dias (D1 a D7)
            <% if (datasCargaCotas[secao.id]) { %>
              · cotas do ETA de <strong><%= datasCargaCotas[secao.id] %></strong>
            <% } else { %>
              · <strong>cotas do ETA ainda não importadas</strong>
            <% } %>
            <% const _janelaAtiva = secao.opcoesJanela.find(op => op.ativo && op.rotulo !== 'Todas as janelas'); %>
            <% if (_janelaAtiva) { %>
              · janela <strong><%= _janelaAtiva.rotulo %></strong>
            <% } %>
            <% const _atraso = diasAtrasoCotas[secao.id]; %>
            <% if (_atraso > 7) { %>
              · <strong class="aviso-atraso" title="A base não tem AGE que cubra nenhum dos 7 dias seguintes (mais de 7 dias sem reenviar) -- todas as colunas de Status/Cota Aberta abaixo aparecem vazias de propósito, não é bug">base desatualizada há <%= _atraso %> dias — sem dado pra nenhum dos 7 dias</strong>
            <% } else if (_atraso > 0) { %>
              · <strong class="aviso-atraso" title="A base não foi reenviada hoje -- Status/Cota Aberta já foram ajustados sozinhos pra continuar batendo com a data real de cada coluna; só os últimos dias da tabela (D<%= 8 - _atraso %> em diante) ficam sem dado, por estarem fora do alcance do arquivo (que só vai até D7)">base desatualizada há <%= _atraso %> dia<%= _atraso > 1 ? 's' : '' %> (Status/Cota Aberta já ajustados; últimos dias sem dado)</strong>
            <% } %>
          </p>
        </div>
      <% }) %>
    </div>
    <div class="panel-header-actions">
      <div class="unidade-toggle">
        <span class="unidade-toggle-label" id="rotulo-unidade">Ver em</span>
        <div class="secao-tabs" role="group" aria-labelledby="rotulo-unidade">
          <button type="button" class="secao-tab unidade-tab is-active" data-unidade="min" aria-pressed="true" title="Mostrar os valores em minutos">Minutos</button>
          <button type="button" class="secao-tab unidade-tab" data-unidade="qtd" aria-pressed="false" title="Mostrar os valores em quantidade de ordens">Ordens</button>
        </div>
      </div>
      <%- include('partials/filtro-aliada-chips') %>
      <%- include('partials/filtro-regiao-chips') %>
      <nav class="secao-tabs" aria-label="Seção">
        <% secoes.forEach((secao, i) => { %>
          <button type="button" class="secao-tab secao-aba <%= i === 0 ? 'is-active' : '' %>" data-secao="<%= secao.id %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>"><%= secao.label %></button>
        <% }) %>
      </nav>
    </div>
  </div>

  <% secoes.forEach((secao, i) => { %>
    <div class="secao-painel" data-secao="<%= secao.id %>" <%= i === 0 ? '' : 'hidden' %>>
      <div class="janela-filtro">
        <span class="unidade-toggle-label">Janela</span>
        <div class="secao-tabs" role="group" aria-label="Filtrar <%= secao.label %> por janela de horário">
          <% secao.opcoesJanela.forEach(op => { %>
            <a href="<%= op.href %>" class="secao-tab <%= op.ativo ? 'is-active' : '' %>" aria-pressed="<%= op.ativo ? 'true' : 'false' %>"><%= op.rotulo %></a>
          <% }) %>
        </div>
      </div>
      <%- include('partials/tabela-projecao', { secao: secao, dias: dias }) %>
    </div>
  <% }) %>

  <p class="tabela-nota">
    Use o filtro <strong>Janela</strong> (acima de cada tabela) pra ver só uma janela de horário específica em vez da soma de todas — com uma janela só selecionada, cada <strong>bucket</strong> vira sempre Aberto/Fechado (nunca Parcial); o "Total geral" ainda pode ser Parcial porque ali quem varia é o bucket, não a janela.
    <strong>Status</strong>, <strong>Cota Aberta</strong> e <strong>Consumo</strong> = rótulo <code>Age</code> (D1 a D7) do arquivo do ETA, somando/contando as janelas do bucket incluídas no filtro atual (Consumo = Cota Usada) · <strong>Parcial</strong> = nem todas as janelas do bucket concordam no Status ·
    células com fundo destacado = Aberto no ETA com Cota Aberta = 0 · seta <svg class="volume-flag volume-flag-alerta" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg> = Consumo maior que a Cota Aberta.
    <strong>Atenção:</strong> se a base não for reenviada todo dia, o sistema ajusta sozinho qual linha do arquivo (Age=D0..D7) corresponde a cada data real — mas o arquivo só cobre 7 dias a partir do dia em que foi gerado, então quanto mais desatualizada a base, menos dos 7 dias aqui aparecem com dado (os últimos ficam "—"). Confira o aviso acima de cada tabela quando isso acontecer.
    Use <strong>Ver em</strong> para alternar entre minutos e quantidade de ordens.
  </p>
</section>

<dialog id="cotas-upload-modal" class="config-modal" data-abrir-automatico="<%= cotasUpload ? 'true' : '' %>">
  <div class="modal-header">
    <h3 title="Envia os relatórios de cotas do ETA (Excel, aba Export) — um arquivo por tipo. Cada envio substitui todo o conteúdo daquele tipo.">Analítico Disponibilidade e Consumo PB</h3>
    <button type="button" class="icon-btn" id="cotas-upload-close-btn" aria-label="Fechar" title="Fechar">&times;</button>
  </div>

  <% if (cotasUpload === 'ok') { %>
    <p class="alert alert-ok" data-auto-dismiss style="margin: 1rem 1.25rem 0;">Cotas de <strong><%= rotuloTipo(cotasUploadTipo) %></strong> importadas: <strong><%= cotasUploadLinhas %></strong> linhas.</p>
  <% } else if (cotasUpload === 'erro') { %>
    <p class="alert alert-erro" data-auto-dismiss style="margin: 1rem 1.25rem 0;">Falha ao importar cotas<%= cotasUploadTipo ? ' de ' + rotuloTipo(cotasUploadTipo) : '' %>: <%= cotasUploadErro %></p>
  <% } %>

  <div class="upload-compact-grid">
    <% tiposCotas.forEach(({ tipo, label }) => { %>
      <form class="cota-upload-item" method="post" action="/cotas/upload/<%= tipo %>" enctype="multipart/form-data" data-loading="Enviando e processando o arquivo…">
        <input type="hidden" name="voltarPara" value="<%= linkProjecaoD1D7 %>" />
        <div class="cota-upload-head">
          <span class="cota-upload-tipo"><%= label %></span>
          <% if (datasCargaCotas[tipo]) { %>
            <span class="cota-upload-data" title="Última atualização de <%= label %>">atualizado <%= datasCargaCotas[tipo] %></span>
          <% } else { %>
            <span class="cota-upload-data cota-upload-nunca" title="Nunca enviado">nunca enviado</span>
          <% } %>
        </div>
        <div class="cota-upload-row">
          <input type="file" name="arquivo" accept=".xlsx" required aria-label="Arquivo de cotas de <%= label %>" />
          <button type="submit" title="Enviar e substituir as cotas de <%= label %>">Enviar</button>
        </div>
      </form>
    <% }) %>
  </div>
  <p class="hint" style="margin: 0 1.25rem 1.25rem;">Cada envio <strong>substitui</strong> todo o conteúdo daquele tipo. <strong>Instalação</strong>, <strong>Serviço</strong>, <strong>ME</strong> e <strong>Reparos</strong> alimentam as tabelas acima.</p>
</dialog>

<%- include('partials/footer') %>
