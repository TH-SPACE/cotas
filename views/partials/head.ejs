<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Calculadora de Cotas - GO' %></title>
  <link rel="icon" type="image/svg+xml" href="/img_vivo/vivo-tablet-lista-purpura-esquerda-320x320.svg" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <h1 title="Estima quantos técnicos são necessários para atender o backlog de reparos de Goiânia">
      <a href="/" class="topbar-link">
        <img src="/img_vivo/vivo-tablet-lista-purpura-esquerda-320x320.svg" alt="" class="topbar-logo" />
        Calculadora de Cotas <span class="badge" title="Cluster GOIANIA">GO</span>
      </a>
    </h1>
    <% // Navbar = só as 4 páginas do sistema (Início / Resumo COTAS / Cotas
       // Planejadas / Projeção D1-D7). Os atalhos das seções (Instalações/
       // Serviços/ME/Reparos) saíram daqui faz tempo (viraram abas dentro do
       // cabeçalho de cada painel na home, ver index.ejs `navAbasSecao`).
       // Configurações e Salvar planejamento também não ficam mais numa barra
       // lateral (removida pra tabela ganhar largura, 2026-07-27) -- agora são
       // 2 ícones discretos em .topbar-acoes, só na home (abaixo). `linkVoltar`
       // preserva os filtros ao voltar pra index a partir das outras páginas. %>
    <nav class="topbar-nav" aria-label="Navegação principal">
      <a href="<%= typeof linkVoltar !== 'undefined' ? linkVoltar : '/' %>" class="topbar-nav-item" title="Página inicial — backlog de Instalações, Serviços, ME e Reparos">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>
        <span>Início</span>
      </a>
      <a href="<%= typeof linkResumoCotas !== 'undefined' ? linkResumoCotas : '/resumo-cotas' %>" class="topbar-nav-item" title="Ver resumo consolidado de COTAS(min) de Instalação, ME, Serviços e Reparos, um por bucket">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span>Resumo COTAS</span>
      </a>
      <a href="<%= typeof linkCotasPlanejadas !== 'undefined' ? linkCotasPlanejadas : '/cotas-planejadas' %>" class="topbar-nav-item" title="Cotas planejadas por bucket em cada janela, comparadas com as cotas do dia (D0) do Elos">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M8 4H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="m9 14 2 2 4-4"/></svg>
        <span>Cotas Planejadas</span>
      </a>
      <a href="<%= typeof linkProjecaoD1D7 !== 'undefined' ? linkProjecaoD1D7 : '/projecao-d1-d7' %>" class="topbar-nav-item" title="Projeção de Status, Cota Aberta e Consumo por bucket para os próximos 7 dias (D1 a D7)">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v3M16 3v3"/><path d="M8 13h2M13 13h3M8 17h2M13 17h3"/></svg>
        <span>Projeção D1-D7</span>
      </a>
    </nav>
    <div class="topbar-acoes">
      <% // Ação contextual: só aparece nas páginas que têm o <dialog> de upload
         // de cotas (cotas-planejadas e, desde 2026-07-27, projecao-d1-d7 --
         // ambas mostram cotas do ETA e se beneficiam de reenviar direto dali). %>
      <% if (typeof paginaAtual !== 'undefined' && (paginaAtual === 'cotas-planejadas' || paginaAtual === 'projecao-d1-d7')) { %>
        <button type="button" class="btn-secundario btn-com-icone" id="cotas-upload-open-btn" aria-haspopup="dialog" aria-controls="cotas-upload-modal" title="Enviar Analítico Disponibilidade e Consumo PB (um arquivo por tipo)">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M6 10l6-6 6 6"/><path d="M4 20h16"/></svg>
          Upload de cotas
        </button>
      <% } %>
      <% // Só na home: Salvar planejamento e Configurações, discretos (ícone só) --
         // antes viviam numa barra lateral fixa (removida pra dar mais largura
         // pra tabela). %>
      <% if (typeof pathAtual !== 'undefined' && pathAtual === '/') { %>
        <button type="button" class="icon-btn" id="snapshot-manual-btn" title="Salvar planejamento — salva ORDENS e COTAS(min) atuais no histórico, usado como coluna Planej. em Cotas Planejadas amanhã">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        </button>
        <a href="<%= linkConfiguracoes %>" class="icon-btn" title="Configurações: previsto, janelas, Carga, PU, tempos e upload de backlog">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.65 1.65 0 0 0-1.8-.3 1.65 1.65 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.65 1.65 0 0 0 .3-1.8 1.65 1.65 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.65 1.65 0 0 0 1.8.3H9a1.65 1.65 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.65 1.65 0 0 0 1 1.5 1.65 1.65 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.65 1.65 0 0 0-.3 1.8V9a1.65 1.65 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.65 1.65 0 0 0-1.5 1z"/></svg>
        </a>
      <% } %>
    </div>
  </header>
  <main class="container">
