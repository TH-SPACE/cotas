        <tr>
          <th class="num col-backlog col-divider" title="Total de serviços em aberto no bucket (regra de backlog no topo da página)">Backlog Serviços</th>
          <th class="num col-backlog" title="Backlog de Serviços × percentual de resolução — percentual configurável por aliada na faixa de cada aliada">Previsto</th>
