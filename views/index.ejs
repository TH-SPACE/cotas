<%- include('partials/head') %>
<% const numCls = (grupo, valor) => `num ${grupo}${valor === 0 ? ' valor-zero' : ''}`; %>
<% // Cabeçalho de janela em 2 linhas ("08:30<br>10:30") em vez de 1 ("08:30 - 10:30")
   // pra cada uma das 8 colunas de horário de Instalações precisar de bem menos largura. %>
<% const janelaDuasLinhas = (label) => label.replace(' - ', '<br>'); %>
<% // Sempre recalculado a partir da tabela — não depende de acabar de subir um CSV,
   // então o aviso continua aparecendo em qualquer carregamento da página enquanto
   // existir produto com PU=0, não só logo depois do upload. %>
<% const calcularProdutosSemPu = (lista) => lista.filter(p => p.pu == 0).map(p => p.produto); %>
<% // Escala das barras de magnitude da coluna Backlog: comprimento relativo ao
   // maior bucket da própria seção. UMA cor só pra todas as barras -- pintar
   // "mais escuro onde é maior" duplicaria o encode (o comprimento já diz isso)
   // e é anti-pattern em categoria nominal (bucket não tem ordem natural). %>
<% const maiorDe = (lista, campo) => Math.max(1, ...lista.map(l => Number(l[campo]) || 0)); %>
<% const maxBacklogInstalacoes = maiorDe(linhasInstalacoes, 'backlogInstalacoes'); %>
<% const maxBacklogServicos = maiorDe(linhasServicos, 'backlogServicos'); %>
<% const maxBacklogMe = maiorDe(linhasMe, 'backlogMe'); %>
<% const maxBacklogReparos = maiorDe(linhas, 'backlogReparos'); %>
<% const larguraBarra = (valor, maximo) => (Math.max(0, Number(valor) || 0) / maximo * 100).toFixed(1); %>
<% // Botões "Previsto (X%)" e "Sugestão" no cabeçalho das 4 tabelas: abrem o
   // modal #config-rapido-modal (ver main.js) pra editar Previsto/Carga sem
   // precisar ir em Configurações. `campo` diz ao modal/rota qual dos dois é. %>
<% // No botão "Sugestão" (campo carga), `exemplo` carrega o Previsto do 1º bucket
   // da seção + o Previsto total, pra simular a fórmula com dado real no modal
   // em vez de números fixos/inventados. %>
<% // `aliada` (opcional) faz o botão editar o override DAQUELA aliada (data-aliada
   // -> aliadaConfig no POST) em vez do padrão global; `herdado` marca visualmente
   // que a aliada ainda herda o global (cfg-herdado) vs tem valor próprio (cfg-proprio). %>
<% const botaoConfigRapido = (campo, tipo, label, valor, texto, titulo, exemplo, aliada, herdado) => {
  const atributosExemplo = exemplo
    ? Object.entries(exemplo).map(([chave, v]) => ` data-exemplo-${chave}="${v}"`).join('')
    : '';
  const attrAliada = aliada ? ` data-aliada="${aliada}"` : '';
  const clsHerdado = aliada ? (herdado ? ' cfg-herdado' : ' cfg-proprio') : '';
  return `<button type="button" class="config-rapido-btn${clsHerdado}" data-campo="${campo}" data-tipo="${tipo}" data-label="${label}" data-valor="${valor}" title="${titulo}"${attrAliada}${atributosExemplo}>${texto}</button>`;
}; %>
<% // Botão "ORDENS" (cabeçalho de grupo, colspan): abre o modal #janelas-edit-modal
   // (main.js) pra editar as % de janela de 1 seção -- `data-janelas` carrega as
   // editáveis + a última (sempre o restante, calculado, nunca enviada ao servidor). %>
<% const botaoOrdens = (tipo, label, editaveis, labelsJanela, aliada, herdado) => {
  const somaEditaveis = editaveis.reduce((acc, e) => acc + Number(e.valor), 0);
  const itens = editaveis.map((e, i) => ({ nome: e.nome, rotulo: labelsJanela[i], valor: e.valor }));
  itens.push({ nome: null, rotulo: labelsJanela[labelsJanela.length - 1], valor: Math.max(0, 100 - somaEditaveis) });
  const attrAliada = aliada ? ` data-aliada="${aliada}"` : '';
  const clsHerdado = aliada ? (herdado ? ' cfg-herdado' : ' cfg-proprio') : '';
  return `<button type="button" class="ordens-editar-btn${clsHerdado}" data-tipo="${tipo}" data-label="${label}" data-janelas='${JSON.stringify(itens)}' title="Previsto dividido entre as ${labelsJanela.length} janelas de horário — clique para editar as % de ${aliada || 'todas as aliadas'}"${attrAliada}>ORDENS</button>`;
}; %>
<% // Formata número curto pro chip (2,9 em vez de 2.90; 50 em vez de 50.00). %>
<% const numChip = (v) => { const n = Number(v); return (Number.isInteger(n) ? String(n) : n.toFixed(2).replace(/\.?0+$/, '')).replace('.', ','); }; %>
<% // Logo da aliada (public/ability.png, public/ondacom.png). Aliada sem logo
   // (VIVO) cai no badge de texto colorido de sempre. Usado no cabeçalho da faixa. %>
<% const LOGOS_ALIADA = { ABILITY: 'ability.png', ONDACOM: 'ondacom.png' }; %>
<% const marcaAliada = (aliada, corIdx) => {
  const logo = LOGOS_ALIADA[String(aliada).toUpperCase()];
  return logo
    ? `<img src="/${logo}" alt="${aliada}" class="aliada-logo" />`
    : `<span class="aliada-badge aliada-color-${corIdx}">${aliada}</span>`;
}; %>
<% // Faixa de configuração POR ALIADA: renderizada no divisor de cada grupo de
   // aliada dentro da seção. Mostra o valor EFETIVO de cada campo daquela aliada
   // (herda o global se não tiver override) e, ao clicar, abre os mesmos modais
   // já existentes gravando só o override da aliada. `cfg` = configPorAliada<Secao>[aliada].
   // colspan = 2 (aliada+bucket) + 3 (backlog) + 2×janelas + 2 (pu+técnicos). %>
<% const faixaAliada = (tipo, label, aliada, corIdx, cfg, labelsJanela) => {
  const colspan = 2 + 3 + labelsJanela.length * 2 + 2;
  const exCarga = { bucket: cfg.exemploPrevisto, total: cfg.exemploTotal, nome: cfg.exemploNome };
  const exMeta = { pu: cfg.exemploPu, nome: cfg.exemploNome };
  const chips = [
    botaoConfigRapido('previsto', tipo, label, cfg.percentual, `Previsto ${numChip(cfg.percentual)}%`, `Previsto de ${aliada} — clique para editar`, null, aliada, !cfg.overridePercentual),
    botaoConfigRapido('carga', tipo, label, cfg.carga, `Carga ${numChip(cfg.carga)}`, `Carga de ${aliada} (base da Sugestão) — clique para editar`, exCarga, aliada, !cfg.overrideCarga),
    botaoOrdens(tipo, label, cfg.janelasEditaveis, labelsJanela, aliada, !cfg.overrideJanelas),
    botaoConfigRapido('metaPu', tipo, label, cfg.metaPu, `Meta PU ${numChip(cfg.metaPu)}`, `Meta de PU por técnico de ${aliada} — clique para editar`, exMeta, aliada, !cfg.overrideMetaPu),
  ];
  return `<tr class="aliada-config-row"><td colspan="${colspan}" class="aliada-config-td">`
    + `<div class="aliada-config-faixa">`
    + `<span class="aliada-config-nome">${marcaAliada(aliada, corIdx)}configuração da aliada</span>`
    + `<span class="aliada-config-chips">${chips.join('')}</span>`
    + `</div></td></tr>`;
}; %>
<% // Abas de seção no canto direito do cabeçalho de cada painel -- mesma posição/
   // estilo de Cotas Planejadas (.tabela-card-acoes > .secao-tabs), em vez de uma
   // barra solta acima dos painéis. Gerada 1x por seção (só a do painel visível
   // aparece; o JS genérico de abas mantém as 4 cópias em sincronia). %>
<% const SECOES_HOME = [
  { id: 'instalacoes', label: 'Instalação' },
  { id: 'servicos', label: 'Serviços' },
  { id: 'me', label: 'ME' },
  { id: 'reparos', label: 'Reparos' },
]; %>
<% const navAbasSecao = (ativa) => `<nav class="secao-tabs" aria-label="Seção" data-storage-key="calc_secao_home">${SECOES_HOME.map(s => `<button type="button" class="secao-tab secao-aba${s.id === ativa ? ' is-active' : ''}" data-secao="${s.id}" aria-pressed="${s.id === ativa ? 'true' : 'false'}">${s.label}</button>`).join('')}</nav>`; %>

<!-- Modal de confirmação do save de planejamento (gatilho agora fica no topbar, ver head.ejs) -->
<dialog id="snapshot-confirm-modal" class="config-modal">
  <div class="modal-header">
    <h3>Salvar planejamento para amanhã?</h3>
    <button type="button" class="icon-btn" id="snapshot-confirm-close-btn" aria-label="Fechar" title="Fechar">&times;</button>
  </div>
  <div class="modal-body">
    <p>Os valores de <strong>ORDENS</strong> e <strong>COTAS(min)</strong> de cada bucket e janela que estão na tela agora serão salvos no histórico.</p>
    <p>Amanhã, esses valores aparecerão como <strong>Planej.</strong> na página de <strong>Cotas Planejadas</strong>.</p>
    <p class="hint">Se já existe um planejamento salvo para hoje, ele será substituído.</p>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn-secundario" id="snapshot-confirm-close-btn-2">Cancelar</button>
    <button type="button" id="snapshot-confirm-ok-btn">Salvar</button>
  </div>
</dialog>

  <div class="home-content">

<section class="panel secao-painel" id="secao-instalacoes" data-secao="instalacoes">
  <div class="panel-header panel-header-row">
    <div>
      <h2 title="Backlog de instalações agrupado por Aliada e Bucket, cruzando depara_bucket com backlog_instalacoes pelo ARD (ARMARIO)">
        <svg class="title-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>
        Resumo de Backlog de Instalações por Bucket
        <span class="badge" title="Este resumo conta instalação/ME/serviços do CSV diário do ELOS — reparos têm seção própria">INSTALAÇÕES</span>
      </h2>
    </div>
    <div class="panel-header-actions">
      <%- include('partials/filtro-aliada-chips') %>
      <%- navAbasSecao('instalacoes') %>
    </div>
  </div>

  <details class="filtro-detalhes" id="filtro-instalacoes-detalhes">
    <summary>
      <svg class="filtro-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
      Filtros
      <span class="filtro-resumo">
        Status <%= statusInstalacaoSelecionados.length %>/<%= filtrosDisponiveisInstalacoes.status.length %>
        &middot; Status Reason <%= statusReasonInstalacaoSelecionados.length %>/<%= filtrosDisponiveisInstalacoes.statusReason.length %>
        &middot; Tecnologia <%= tecnologiaAcessoSelecionadas.length %>/<%= filtrosDisponiveisInstalacoes.tecnologiaAcesso.length %>
      </span>
    </summary>
    <form method="get" action="/" class="filtro-tecnologia filtro-tecnologia-colunas" id="filtro-instalacoes-form">
      <input type="hidden" name="formInstalacaoEnviado" value="1" />
      <div class="filtro-grupo">
        <span class="filtro-tecnologia-label">Status:</span>
        <% filtrosDisponiveisInstalacoes.status.forEach(valor => { %>
          <label class="filtro-tecnologia-item">
            <input type="checkbox" name="statusInstalacao" value="<%= valor %>" <%= statusInstalacaoSelecionados.includes(valor) ? 'checked' : '' %> />
            <%= valor %>
          </label>
        <% }) %>
      </div>
      <div class="filtro-grupo">
        <span class="filtro-tecnologia-label">Status Reason:</span>
        <% filtrosDisponiveisInstalacoes.statusReason.forEach(valor => { %>
          <label class="filtro-tecnologia-item">
            <input type="checkbox" name="statusReasonInstalacao" value="<%= valor %>" <%= statusReasonInstalacaoSelecionados.includes(valor) ? 'checked' : '' %> />
            <%= valor === '' ? '(sem motivo)' : valor %>
          </label>
        <% }) %>
      </div>
      <div class="filtro-grupo">
        <span class="filtro-tecnologia-label">Tecnologia:</span>
        <% filtrosDisponiveisInstalacoes.tecnologiaAcesso.forEach(valor => { %>
          <label class="filtro-tecnologia-item">
            <input type="checkbox" name="tecnologiaAcesso" value="<%= valor %>" <%= tecnologiaAcessoSelecionadas.includes(valor) ? 'checked' : '' %> />
            <%= valor %>
          </label>
        <% }) %>
      </div>
      <%- include('partials/hidden-config-estado', { exceto: ['statusInstalacao', 'statusReasonInstalacao', 'tecnologiaAcesso', 'formInstalacaoEnviado'] }) %>
    </form>
  </details>

  <% const produtosInstalacoesSemPu = calcularProdutosSemPu(puProdutos); %>
  <% if (produtosInstalacoesSemPu.length > 0) { %>
    <p class="alert alert-aviso">
      <strong>Atenção:</strong> <%= produtosInstalacoesSemPu.length %> Specification Product(s) sem PU configurado: <%= produtosInstalacoesSemPu.join(', ') %>.
      Ajuste em "PU por Specification Product" na página de Configurações — até lá, eles contam PU=0 no cálculo.
    </p>
  <% } %>

  <div class="table-scroll">
    <table class="cotas-table cotas-table-compact">
      <colgroup>
        <col class="colw-aliada" />
        <col class="colw-bucket" />
        <col class="colw-num" /><col class="colw-num" /><col class="colw-num" />
        <% janelasInstalacaoLabels.forEach(() => { %><col class="colw-num" /><% }) %>
        <% janelasInstalacaoLabels.forEach(() => { %><col class="colw-num" /><% }) %>
        <col class="colw-num" /><col class="colw-num" />
      </colgroup>
      <thead>
        <tr>
          <th rowspan="2" title="Empresa aliada responsável pelo bucket">Aliada</th>
          <th rowspan="2" title="Agrupamento de ARDs (armários) mapeado em depara_bucket">Bucket</th>
          <th colspan="3" class="group-header col-backlog col-divider" title="Quantidade de instalações em aberto, a meta calculada sobre elas e a Sugestão baseada na Carga configurada">BACKLOG</th>
          <th colspan="<%= janelasInstalacaoLabels.length %>" class="group-header col-ordens col-divider" title="Previsto de cada bucket dividido entre as janelas de horário — % configurável por aliada na faixa de cada aliada">ORDENS</th>
          <th colspan="<%= janelasInstalacaoLabels.length %>" class="group-header col-minutos col-divider" title="Ordens de cada janela × tempo de instalação do bucket (depara_tempo_bucket)">COTAS(min)</th>
          <th rowspan="2" class="num col-divider" title="Técnicos = PU ÷ Meta de PU por técnico — Meta configurável por aliada na faixa de cada aliada">PU</th>
          <th rowspan="2" class="num" title="Técnicos necessários = PU ÷ Meta de PU por técnico, arredondado para cima (não existe fração de técnico)">Técnicos</th>
        </tr>
        <tr>
          <th class="num col-backlog col-divider" title="Total de instalações em aberto no bucket (regra de backlog no topo da página)">Backlog Instalações</th>
          <th class="num col-backlog" title="Backlog de Instalações × percentual de resolução — percentual configurável por aliada na faixa de cada aliada">Previsto</th>
          <th class="num col-backlog" title="(Previsto do bucket ÷ Previsto total da aliada) × Carga — Carga configurável por aliada na faixa de cada aliada">Sugestão</th>
          <% janelasInstalacaoLabels.forEach((label, i) => { %>
            <th class="num col-ordens <%= i === 0 ? 'col-divider' : '' %>" title="Parte do Previsto alocada para a janela <%= label %>"><%- janelaDuasLinhas(label) %></th>
          <% }) %>
          <% janelasInstalacaoLabels.forEach((label, i) => { %>
            <th class="num col-minutos <%= i === 0 ? 'col-divider' : '' %>" title="Ordens de <%= label %> × tempo de instalação do bucket"><%- janelaDuasLinhas(label) %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% let aliadaAtualInstalacoes = null; %>
        <% linhasInstalacoes.forEach(linha => { %>
          <% const novaAliadaInstalacoes = linha.aliada !== aliadaAtualInstalacoes; aliadaAtualInstalacoes = linha.aliada; %>
          <% if (novaAliadaInstalacoes && configPorAliadaInstalacoes[linha.aliada]) { %><%- faixaAliada('instalacao', 'Instalação', linha.aliada, aliadaCoresInstalacoes[linha.aliada], configPorAliadaInstalacoes[linha.aliada], janelasInstalacaoLabels) %><% } %>
          <tr class="<%= novaAliadaInstalacoes ? 'group-start' : '' %>">
            <td><span class="aliada-badge aliada-color-<%= aliadaCoresInstalacoes[linha.aliada] %>"><%= linha.aliada %></span></td>
            <td class="celula-truncada" title="<%= linha.bucket %>"><%= linha.bucket %></td>
            <td class="<%= numCls('col-backlog', linha.backlogInstalacoes) %> col-divider">
              <%= linha.backlogInstalacoes %>
              <% if (linha.maiorVolume) { %>
                <svg class="volume-flag" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" title="Um dos <%= 3 %> buckets com maior volume de backlog"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
              <% } %>
              <span class="barra-magnitude" aria-hidden="true"><span class="barra-magnitude-fill" style="width: <%= larguraBarra(linha.backlogInstalacoes, maxBacklogInstalacoes) %>%"></span></span>
            </td>
            <td class="<%= numCls('col-backlog', linha.previstoResolucao) %>"><%= linha.previstoResolucao %></td>
            <td class="<%= numCls('col-backlog', linha.sugestao) %>">
              <%= linha.sugestao %>
              <% if (linha.sugestao > linha.previstoResolucao) { %>
                <svg class="volume-flag volume-flag-alerta" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" title="Sugestão maior que o Previsto"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
              <% } %>
            </td>
            <% linha.janelas.forEach((qtd, i) => { %>
              <td class="<%= numCls('col-ordens', qtd) %> <%= i === 0 ? 'col-divider' : '' %>"><%= qtd %></td>
            <% }) %>
            <% linha.minutos.forEach((min, i) => { %>
              <td class="<%= numCls('col-minutos', min) %> <%= i === 0 ? 'col-divider' : '' %>"><%= min %></td>
            <% }) %>
            <td class="<%= numCls('', linha.pu) %> col-divider"><%= linha.pu %></td>
            <td class="<%= numCls('', linha.tecnicos) %>"><%= linha.tecnicos %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2" title="Soma de todos os buckets do cluster GOIANIA">Total geral</td>
          <td class="<%= numCls('col-backlog', totalGeralInstalacoes) %> col-divider"><a href="<%= linkExportarInstalacao %>" class="total-backlog-link" title="Baixar em CSV as ordens que compõem este total, com os filtros atuais"><%= totalGeralInstalacoes %></a></td>
          <td class="<%= numCls('col-backlog', totalPrevistoInstalacoes) %>"><%= totalPrevistoInstalacoes %></td>
          <td class="<%= numCls('col-backlog', totalSugestaoInstalacoes) %>">
            <%= totalSugestaoInstalacoes %>
            <% if (totalSugestaoInstalacoes > totalPrevistoInstalacoes) { %>
              <svg class="volume-flag volume-flag-alerta" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" title="Sugestão maior que o Previsto"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            <% } %>
          </td>
          <% totalJanelasInstalacoes.forEach((qtd, i) => { %>
            <td class="<%= numCls('col-ordens', qtd) %> <%= i === 0 ? 'col-divider' : '' %>"><%= qtd %></td>
          <% }) %>
          <% totalMinutosInstalacoes.forEach((min, i) => { %>
            <td class="<%= numCls('col-minutos', min) %> <%= i === 0 ? 'col-divider' : '' %>"><%= min %></td>
          <% }) %>
          <td class="<%= numCls('', totalPuInstalacoes) %> col-divider"><%= totalPuInstalacoes %></td>
          <td class="<%= numCls('', totalTecnicosInstalacoes) %>"><%= totalTecnicosInstalacoes %></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <p class="data-carga-destaque" title="Data de carga registrada pelo próprio ELOS na coluna DATA_CARGA (backlog_instalacoes) — mesma base do painel de Serviços">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
    Dados atualizados em <strong><%= dataCargaInstalacoes %></strong>
  </p>
  <p class="hint">
    Backlog em aberto = instalação (GOIANIA). Status, motivo e tecnologia são filtráveis abaixo. — esta tela calcula para D+1.
  </p>
</section>

<section class="panel secao-painel" id="secao-servicos" data-secao="servicos" hidden>
  <div class="panel-header panel-header-row">
    <div>
      <h2 title="Backlog de serviços agrupado por Aliada e Bucket, cruzando depara_bucket com backlog_instalacoes pelo ARD (ARMARIO)">
        <svg class="title-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="3"/></svg>
        Resumo de Backlog de Serviços por Bucket
        <span class="badge" title="Este resumo conta ALTERAÇÃO/UPGRADE/DOWNGRADE do CSV diário do ELOS, exceto Mudança de Endereço — instalações e reparos têm seção própria">SERVIÇOS</span>
      </h2>
    </div>
    <div class="panel-header-actions">
      <%- include('partials/filtro-aliada-chips') %>
      <%- navAbasSecao('servicos') %>
    </div>
  </div>

  <details class="filtro-detalhes" id="filtro-servicos-detalhes">
    <summary>
      <svg class="filtro-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
      Filtros
      <span class="filtro-resumo">
        Status <%= statusServicoSelecionados.length %>/<%= filtrosDisponiveisServicos.status.length %>
        &middot; Status Reason <%= statusReasonServicoSelecionados.length %>/<%= filtrosDisponiveisServicos.statusReason.length %>
        &middot; Tecnologia <%= tecnologiaAcessoServicoSelecionadas.length %>/<%= filtrosDisponiveisServicos.tecnologiaAcesso.length %>
      </span>
    </summary>
    <form method="get" action="/" class="filtro-tecnologia filtro-tecnologia-colunas" id="filtro-servicos-form">
      <input type="hidden" name="formServicoEnviado" value="1" />
