            <td class="<%= numCls('', linha.pu) %> col-divider"><%= linha.pu %></td>
            <td class="<%= numCls('', linha.tecnicos) %>"><%= linha.tecnicos %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2" title="Soma de todos os buckets do cluster GOIANIA">Total geral</td>
          <td class="<%= numCls('col-backlog', totalGeralServicos) %> col-divider"><a href="<%= linkExportarServico %>" class="total-backlog-link" title="Baixar em CSV as ordens que compõem este total, com os filtros atuais"><%= totalGeralServicos %></a></td>
